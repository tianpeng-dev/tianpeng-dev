---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Peng Tian's website",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I'm a software engineer based in ShenZhen, currently exploring AI product management.
		</p>
		<p>
			After a few years writing code, I started asking different questions — not "how do we
			build this?" but "what's worth building, and for whom?" AI feels like the right moment to
			ask those questions louder.
		</p>
		<p>This blog is where I work through them in public.</p>
		<h2>What I write about</h2>
		<ul role="list">
			<li>AI product teardowns — Cursor, Perplexity, Claude, and whatever catches my attention</li>
			<li>
				Notes from the transition — engineer to product, the awkward parts and the obvious ones
			</li>
			<li>Tools and workflows I actually use</li>
			<li>Side projects and experiments</li>
			<li>Occasional rambles on tech and building things</li>
		</ul>
		<p>
			Find me on
		</p>
		<ul role="list">
			<li>
				<a
					class="cactus-link inline-block"
					href="https://github.com/tianpeng-dev"
					rel="noopener noreferrer me authn"
					target="_blank">Github</a
				>
			</li>
			<li>
				<a class="cactus-link inline-block" href="mailto:hi@tianpeng.dev"
					>Email — hi@tianpeng.dev</a
				>
			</li>
		</ul>
		<p>Always open to interesting conversations.</p>
	</div>
</PageLayout>
